# ════════════════════════════════════════════════════════════════
#  example.env — шаблон настроек
#  Скопируй в .env и впиши свои значения:   cp example.env .env
#  Файл .env лежит рядом с config.py. В git его НЕ коммитим (.gitignore).
#  Строки с # — комментарии. Кавычки вокруг значений не нужны.
# ════════════════════════════════════════════════════════════════


# ──────────────── PostgreSQL (подключение к базе) ────────────────

# Пользователь БД
DB_USER=postgres

# Пароль этого пользователя (как в psql / createuser).
# Если в пароле есть спецсимволы (@ : / # %) — ничего экранировать не надо.
DB_PASSWORD=change_me

# Адрес сервера БД: localhost, если база на этой же машине
DB_HOST=localhost

# Порт PostgreSQL (по умолчанию 5432)
DB_PORT=5432

# Имя базы данных
DB_NAME=proton

# Только если подключаешься через unix-сокет без пароля (peer-авторизация).
# Например: /var/run/postgresql   Обычно оставляют пустым.
DB_SOCKET_DIR=


# ──────────────── Секреты и шифрование ────────────────

# Секрет для подписи сессий Flask.
# Оставь пустым — сгенерируется сам и сохранится в файл .secret_key.
# Сгенерировать вручную:  python3 -c "import secrets; print(secrets.token_hex(64))"
FLASK_SECRET_KEY=

# Pepper для хеширования паролей — случайная строка.
# Сгенерировать:  python3 -c "import secrets; print(secrets.token_hex(32))"
# ВАЖНО: после первого запуска НЕ МЕНЯТЬ — иначе никто не сможет войти.
PASSWORD_PEPPER=

# Ключ шифрования сообщений в БД (AES-256): base64 от 32 байт.
# Оставь пустым — сгенерируется сам и сохранится в файл .encryption_key.
# Сгенерировать:  python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ВАЖНО: после первого запуска НЕ МЕНЯТЬ — все сообщения в БД станут нечитаемыми.
# Сделай резервную копию ключа отдельно от кода.
MESSAGE_ENCRYPTION_KEY=


# ──────────────── Необязательное (есть значения по умолчанию) ────────────────

# Имя аккаунта владельца платформы (по умолчанию fsociety)
PLATFORM_ADMIN_USERNAME=fsociety

# Имя системного бота уведомлений (по умолчанию Proton)
PLATFORM_BOT_USERNAME=Proton

# Базовый адрес для invite-ссылок в группы, без слэша на конце.
# Примеры: https://example.com   или   http://192.168.1.10:5000
LINK_URL=https://example.com

# 1 / true — режим отладки с автоперезапуском. На продакшене не включать.
PROTON_DEBUG=
